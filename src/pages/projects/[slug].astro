---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, tagline, category, period, role, client, stack, highlights, metrics, gallery, links, accent, description } =
  project.data;
const { Content } = await project.render();

const accentMap: Record<string, string> = {
  indigo: 'text-brand-300',
  cyan: 'text-accent-400',
  emerald: 'text-emerald-300',
  amber: 'text-amber-300',
  rose: 'text-rose-300',
  violet: 'text-violet-300',
};
const accentText = accentMap[accent] ?? accentMap.indigo;

// Sibling projects for prev/next nav.
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.slug === project.slug);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;
---

<BaseLayout
  title={title}
  description={description ?? tagline}
  path={Astro.url.pathname}
>
  <!-- Back link -->
  <div class="container-x pt-8">
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 text-sm text-slate-400 transition hover:text-white"
    >
      <Icon name="arrowRight" class="h-4 w-4 rotate-180" />
      All projects
    </a>
  </div>

  <!-- Hero -->
  <section class="container-x pt-10">
    <div class="flex flex-wrap items-center gap-3">
      <span class={`pill border-transparent bg-white/10 ${accentText}`}>{category}</span>
      <span class="font-mono text-xs text-slate-500">{period}</span>
      {client && <span class="font-mono text-xs text-slate-500">· {client}</span>}
    </div>
    <h1 class="mt-5 text-4xl font-bold tracking-tight text-white sm:text-5xl">{title}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-300">{tagline}</p>

    <!-- CTA buttons -->
    {
      (links?.live || links?.repo || links?.caseStudy) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {links?.live && (
            <a href={links.live} target="_blank" rel="noopener noreferrer" class="btn-primary">
              <Icon name="external" class="h-4 w-4" />
              View live
            </a>
          )}
          {links?.repo && (
            <a href={links.repo} target="_blank" rel="noopener noreferrer" class="btn-ghost">
              <Icon name="github" class="h-4 w-4" />
              Source code
            </a>
          )}
          {links?.caseStudy && (
            <a href={links.caseStudy} target="_blank" rel="noopener noreferrer" class="btn-ghost">
              <Icon name="external" class="h-4 w-4" />
              Case study
            </a>
          )}
        </div>
      )
    }
  </section>

  <!-- Metrics row -->
  {
    metrics.length > 0 && (
      <section class="container-x mt-12">
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
          {metrics.map((m) => (
            <div class="card p-5 text-center">
              <div class={`text-2xl font-bold ${accentText}`}>{m.value}</div>
              <div class="mt-1 font-mono text-xs uppercase tracking-wider text-slate-500">{m.label}</div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Two-column: meta sidebar + body -->
  <section class="container-x mt-12">
    <div class="grid gap-10 lg:grid-cols-[1fr_280px]">
      <!-- Body -->
      <article class="prose prose-invert max-w-none">
        <!-- Key highlights, surfaced before the long-form body. -->
        <h2 id="highlights">Key outcomes</h2>
        <ul>
          {highlights.map((h) => <li>{h}</li>)}
        </ul>

        <!-- Markdown body authored per-project. -->
        <Content />
      </article>

      <!-- Sidebar -->
      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-slate-500">My role</h2>
          <p class="mt-2 text-sm text-slate-300">{role}</p>
        </div>

        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-slate-500">Tech stack</h2>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {stack.map((s) => <span class="pill">{s}</span>)}
          </div>
        </div>

        {client && (
          <div>
            <h2 class="font-mono text-xs uppercase tracking-widest text-slate-500">Client</h2>
            <p class="mt-2 text-sm text-slate-300">{client}</p>
          </div>
        )}

        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-slate-500">Timeline</h2>
          <p class="mt-2 text-sm text-slate-300">{period}</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Gallery -->
  {
    gallery.length > 0 && (
      <section class="container-x mt-16">
        <h2 class="text-2xl font-bold text-white">Gallery</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {gallery.map((src) => (
            <img
              src={src}
              alt={`${title} screenshot`}
              loading="lazy"
              class="card w-full rounded-xl object-cover"
            />
          ))}
        </div>
      </section>
    )
  }

  <!-- Prev / next nav -->
  <section class="container-x mt-20">
    <div class="hr-soft mb-8"></div>
    <div class="grid gap-4 sm:grid-cols-2">
      {prev ? (
        <a href={`/projects/${prev.slug}`} class="card card-hover group p-5">
          <span class="font-mono text-xs uppercase tracking-widest text-slate-500">← Previous</span>
          <p class="mt-1 font-semibold text-white">{prev.data.title}</p>
        </a>
      ) : <span></span>}
      {next && (
        <a href={`/projects/${next.slug}`} class="card card-hover group p-5 text-right">
          <span class="font-mono text-xs uppercase tracking-widest text-slate-500">Next →</span>
          <p class="mt-1 font-semibold text-white">{next.data.title}</p>
        </a>
      )}
    </div>
  </section>
</BaseLayout>
