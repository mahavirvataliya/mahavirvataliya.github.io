---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Work"
  description="Projects Mahavir Vataliya has owned end-to-end: agentic AI platforms, high-traffic web apps, AI voice agents, and infrastructure."
  path="/projects"
>
  <section class="pt-14">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900">Work</h1>
    <p class="mt-3 leading-relaxed text-neutral-600">
      Things I've built and run in production. Each page has the problem, what I did, and the stack.
    </p>

    <div class="mt-8">
      {
        projects.map((p) => (
          <a href={`/projects/${p.slug}`} class="row group no-underline">
            <div class="flex items-baseline justify-between gap-4">
              <span class="row-title font-semibold text-neutral-900">{p.data.title}</span>
              <span class="meta shrink-0">{p.data.period}</span>
            </div>
            <p class="mt-1 text-neutral-600">{p.data.tagline}</p>
            <p class="meta mt-1">
              <span class="text-neutral-400">{p.data.category}</span>
              {' · '}
              {p.data.stack.slice(0, 6).join(' · ')}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
