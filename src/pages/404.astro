---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" noindex>
  <section class="flex min-h-[50vh] flex-col items-start justify-center py-20">
    <p class="text-6xl font-bold text-neutral-200">404</p>
    <h1 class="mt-4 text-2xl font-bold text-neutral-900">That page doesn't exist.</h1>
    <p class="mt-3">
      <a href="/" class="text-neutral-900 underline underline-offset-2">← Home</a>
    </p>
  </section>
</BaseLayout>
