---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="container-x flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-mono text-6xl font-bold text-gradient">404</p>
    <h1 class="mt-4 text-3xl font-bold text-white sm:text-4xl">This page wandered off.</h1>
    <p class="mt-3 max-w-md text-slate-400">
      The page you're looking for doesn't exist or has moved. Let's get you back on track.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn-primary">
        <Icon name="arrowRight" class="h-4 w-4 rotate-180" />
        Back home
      </a>
      <a href="/projects" class="btn-ghost">Browse projects</a>
    </div>
  </section>
</BaseLayout>
