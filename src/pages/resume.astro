---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

// PDFs are gitignored for privacy and only exist locally — CI builds won't
// have them. Detect at build time and fall back to an email request.
const resumeFiles = [
  {
    title: 'Full-Stack & AI Product Engineer',
    detail: 'The current version. Full-stack engineering, agentic AI products, scaling, cloud/DevOps.',
    file: '/Mahavir_Vataliya_FullStack_AI_Product_Engineer.pdf',
    filename: 'Mahavir_Vataliya_FullStack_AI_Product_Engineer.pdf',
  },
  {
    title: 'Software Engineer (earlier version)',
    detail: 'Kept for reference.',
    file: '/Mahavir_Resume_CA.pdf',
    filename: 'Mahavir_Resume_CA.pdf',
  },
];

const resumes = resumeFiles.filter((r) => existsSync(`public${r.file}`));
const pdfsAvailable = resumes.length > 0;
---

<BaseLayout
  title="Résumé"
  description="Mahavir Vataliya's résumé — full-stack engineer, 8 years, React/NextJS, Python, agentic AI."
  path="/resume"
>
  <section class="pt-14">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900">Résumé</h1>

    {
      pdfsAvailable ? (
        <>
          <p class="mt-3 leading-relaxed text-neutral-600">
            Pick a version — the first one is current.
          </p>
          <div class="mt-8">
            {resumes.map((r) => (
              <div class="row">
                <p class="font-semibold text-neutral-900">{r.title}</p>
                <p class="mt-1 text-neutral-600">{r.detail}</p>
                <p class="mt-2 flex gap-4 text-sm">
                  <a href={r.file} download={r.filename} class="text-neutral-900 underline underline-offset-2">
                    Download ↓
                  </a>
                  <a href={r.file} target="_blank" rel="noopener noreferrer" class="text-neutral-900 underline underline-offset-2">
                    Open ↗
                  </a>
                </p>
              </div>
            ))}
          </div>
        </>
      ) : (
        <>
          <p class="mt-3 leading-relaxed text-neutral-600">
            I keep my résumé out of public repositories. Email me and I'll send the current PDF over — usually within a day.
          </p>
          <p class="mt-6">
            <a
              href={`mailto:${site.email}?subject=R%C3%A9sum%C3%A9%20request`}
              class="inline-block rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white no-underline hover:bg-neutral-700"
            >
              Email me
            </a>
          </p>
        </>
      )
    }
  </section>
</BaseLayout>
