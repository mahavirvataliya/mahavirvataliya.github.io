---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Writing"
  description="Notes by Mahavir Vataliya from real systems — production AI, performance, infrastructure, remote work."
  path="/blog"
>
  <section class="pt-14">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900">Writing</h1>
    <p class="mt-3 leading-relaxed text-neutral-600">
      Notes from things I've shipped. No tutorials.
    </p>

    <div class="mt-8">
      {
        posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="row group no-underline">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <span class="row-title text-neutral-900">{post.data.title}</span>
              <time class="meta shrink-0" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <p class="mt-1 text-neutral-600">{post.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
