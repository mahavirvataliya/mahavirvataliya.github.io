---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site, socials, lookingFor } from '../data/site';

// Web3Forms key is public by design (browser POSTs to their API).
// Set PUBLIC_WEB3FORMS_ACCESS_KEY in your env; falls back to a placeholder
// so the form renders even before the key is configured.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? 'YOUR_ACCESS_KEY';
---

<BaseLayout
  title="Contact"
  description={`Get in touch with Mahavir Vataliya — ${site.availability}.`}
  path="/contact"
>
  <section class="container-x pt-16 sm:pt-20">
    <SectionHeading
      eyebrow="Contact"
      title="Let's talk."
      description="Tell me what you're building. I'm open to remote roles, contract work, and interesting AI / full-stack problems."
    />

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.2fr_1fr]">
      <!-- Form -->
      <div class="card p-7 sm:p-9">
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-5"
        >
          <!-- Web3Forms access key -->
          <input type="hidden" name="access_key" value={accessKey} />
          <!-- Subject line for the email Mahavir receives. -->
          <input type="hidden" name="subject" value="New message from your portfolio" />
          <!-- Honeypot spam trap — humans leave it blank. -->
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-slate-200">
                Name <span class="text-accent-400">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Your name"
                class="w-full rounded-xl border border-white/10 bg-ink-900 px-4 py-3 text-sm text-white placeholder-slate-500 transition focus:border-brand-400/50 focus:outline-none focus:ring-2 focus:ring-brand-400/30"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-slate-200">
                Email <span class="text-accent-400">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="you@example.com"
                class="w-full rounded-xl border border-white/10 bg-ink-900 px-4 py-3 text-sm text-white placeholder-slate-500 transition focus:border-brand-400/50 focus:outline-none focus:ring-2 focus:ring-brand-400/30"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="mb-1.5 block text-sm font-medium text-slate-200">
              Subject
            </label>
            <input
              type="text"
              id="subject"
              name="subject_line"
              placeholder="What's this about?"
              class="w-full rounded-xl border border-white/10 bg-ink-900 px-4 py-3 text-sm text-white placeholder-slate-500 transition focus:border-brand-400/50 focus:outline-none focus:ring-2 focus:ring-brand-400/30"
            />
          </div>

          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium text-slate-200">
              Message <span class="text-accent-400">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              placeholder="Tell me about your project, role, or idea…"
              class="w-full resize-y rounded-xl border border-white/10 bg-ink-900 px-4 py-3 text-sm text-white placeholder-slate-500 transition focus:border-brand-400/50 focus:outline-none focus:ring-2 focus:ring-brand-400/30"
            ></textarea>
          </div>

          <!-- Submit + status UI -->
          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" class="btn-primary" data-submit>
              <span data-submit-label class="inline-flex items-center gap-2">
                Send message
                <Icon name="arrowRight" class="h-4 w-4" />
              </span>
              <span data-submit-spinner class="hidden items-center gap-2">
                <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.4 0 0 5.4 0 12h4z"></path>
                </svg>
                Sending…
              </span>
            </button>
            <p class="font-mono text-xs text-slate-500">
              <span data-status></span>
            </p>
          </div>

          <!-- Success / error message block -->
          <div
            data-result
            class="hidden rounded-xl border p-4 text-sm"
            role="status"
            aria-live="polite"
          >
          </div>
        </form>
      </div>

      <!-- Sidebar: direct contact -->
      <aside class="space-y-6">
        <div class="card p-7">
          <h3 class="font-mono text-xs uppercase tracking-widest text-slate-500">Direct</h3>
          <ul class="mt-4 space-y-3">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    class="group flex items-center gap-3 rounded-lg p-2 transition hover:bg-white/5"
                    {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    <span class="grid h-9 w-9 place-items-center rounded-lg border border-white/10 bg-white/5 text-slate-300 transition group-hover:border-brand-400/50 group-hover:text-white">
                      <Icon name={s.icon} class="h-4 w-4" />
                    </span>
                    <span class="min-w-0">
                      <span class="block text-sm font-medium text-white">{s.label}</span>
                      <span class="block truncate text-xs text-slate-500">{s.handle}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card p-7">
          <h3 class="font-mono text-xs uppercase tracking-widest text-slate-500">Availability</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">{site.availability}.</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">
            Based in {site.location}. I usually reply within one business day.
          </p>
        </div>

        <div class="card p-7">
          <h3 class="font-mono text-xs uppercase tracking-widest text-slate-500">What I'm looking for</h3>
          <ul class="mt-3 space-y-2">
            {lookingFor.roles.map((r) => (
              <li class="flex gap-2 text-sm text-slate-300">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gradient-brand" />
                {r}
              </li>
            ))}
          </ul>
          <div class="hr-soft my-4"></div>
          <ul class="space-y-2">
            {lookingFor.environment.map((e) => (
              <li class="flex gap-2 text-sm text-slate-400">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500/60" />
                {e}
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <script>
    // Progressive enhancement: submit the form via fetch for inline status,
    // without leaving the page. Falls back to a normal POST if JS is off.
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (form) {
      const submitBtn = form.querySelector('[data-submit]') as HTMLButtonElement;
      const label = form.querySelector('[data-submit-label]') as HTMLElement;
      const spinner = form.querySelector('[data-submit-spinner]') as HTMLElement;
      const result = form.querySelector('[data-result]') as HTMLElement;
      const status = form.querySelector('[data-status]') as HTMLElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        // Honeypot: if filled, silently "succeed" without sending.
        if (formData.get('botcheck')) {
          result.className = 'rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-sm text-emerald-300';
          result.textContent = 'Thanks! Your message has been sent.';
          result.classList.remove('hidden');
          form.reset();
          return;
        }

        submitBtn.disabled = true;
        label.classList.add('hidden');
        spinner.classList.remove('hidden');
        spinner.classList.add('inline-flex');
        status.textContent = 'Sending…';
        result.classList.add('hidden');

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });
          const data = await res.json();
          if (data.success) {
            result.className =
              'rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-sm text-emerald-300';
            result.textContent = "Thanks! Your message has been sent — I'll get back to you shortly.";
            form.reset();
            status.textContent = '';
          } else {
            throw new Error(data.message || 'Submission failed');
          }
        } catch (err) {
          result.className = 'rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-sm text-rose-300';
          result.textContent =
            'Something went wrong sending the message. Please email me directly at mahavir.vataliya110@gmail.com.';
          status.textContent = 'Failed';
        } finally {
          submitBtn.disabled = false;
          label.classList.remove('hidden');
          spinner.classList.add('hidden');
          spinner.classList.remove('inline-flex');
          result.classList.remove('hidden');
        }
      });
    }
  </script>
</BaseLayout>
