---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, socials, lookingFor } from '../data/site';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? 'YOUR_ACCESS_KEY';
---

<BaseLayout
  title="Contact"
  description="How to reach Mahavir Vataliya — email, LinkedIn, GitHub, or the contact form."
  path="/contact"
>
  <section class="pt-14">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900">Contact</h1>
    <p class="mt-3 leading-relaxed text-neutral-600">
      Email is fastest: <a href={`mailto:${site.email}`} class="text-neutral-900 underline underline-offset-2">{site.email}</a>. I reply within a day.
    </p>

    <p class="mt-4 flex flex-wrap gap-x-5 text-sm">
      {
        socials.map((s) => (
          <a
            href={s.href}
            class="text-neutral-900 underline underline-offset-2"
            {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {s.label} ↗
          </a>
        ))
      }
    </p>

    <div class="mt-10 grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <!-- Form -->
      <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="New message from your portfolio" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-neutral-700">Name</span>
            <input
              type="text"
              name="name"
              required
              placeholder="Your name"
              class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm text-neutral-900 placeholder-neutral-400 focus:border-neutral-500 focus:outline-none"
            />
          </label>
          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-neutral-700">Email</span>
            <input
              type="email"
              name="email"
              required
              placeholder="you@example.com"
              class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm text-neutral-900 placeholder-neutral-400 focus:border-neutral-500 focus:outline-none"
            />
          </label>
        </div>

        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-neutral-700">Message</span>
          <textarea
            name="message"
            required
            rows="6"
            placeholder="What are you working on?"
            class="w-full resize-y rounded-md border border-neutral-300 px-3 py-2 text-sm text-neutral-900 placeholder-neutral-400 focus:border-neutral-500 focus:outline-none"
          ></textarea>
        </label>

        <div class="flex items-center gap-4">
          <button
            type="submit"
            class="rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-700 disabled:opacity-50"
            data-submit
          >
            <span data-submit-label>Send</span>
            <span data-submit-spinner class="hidden">Sending…</span>
          </button>
          <span class="text-sm text-neutral-500" data-status aria-live="polite"></span>
        </div>

        <div data-result class="hidden rounded-md border p-3 text-sm" role="status" aria-live="polite"></div>
      </form>

      <!-- Sidebar -->
      <aside>
        <h2 class="h-section">What I'm looking for</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-neutral-600 marker:text-neutral-300">
          {lookingFor.roles.map((r) => <li>{r}</li>)}
        </ul>
        <h3 class="mt-6 text-sm font-semibold text-neutral-700">Environment</h3>
        <ul class="mt-2 list-disc space-y-2 pl-5 text-sm leading-relaxed text-neutral-600 marker:text-neutral-300">
          {lookingFor.environment.map((e) => <li>{e}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (form) {
      const submitBtn = form.querySelector('[data-submit]') as HTMLButtonElement;
      const label = form.querySelector('[data-submit-label]') as HTMLElement;
      const spinner = form.querySelector('[data-submit-spinner]') as HTMLElement;
      const result = form.querySelector('[data-result]') as HTMLElement;
      const status = form.querySelector('[data-status]') as HTMLElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        if (formData.get('botcheck')) {
          result.className = 'rounded-md border border-neutral-300 bg-neutral-50 p-3 text-sm';
          result.textContent = 'Thanks — message sent.';
          result.classList.remove('hidden');
          form.reset();
          return;
        }

        submitBtn.disabled = true;
        label.classList.add('hidden');
        spinner.classList.remove('hidden');
        status.textContent = 'Sending…';
        result.classList.add('hidden');

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });
          const data = await res.json();
          if (data.success) {
            result.className = 'rounded-md border border-neutral-300 bg-neutral-50 p-3 text-sm';
            result.textContent = "Thanks — I'll get back to you shortly.";
            form.reset();
            status.textContent = '';
          } else {
            throw new Error(data.message || 'failed');
          }
        } catch {
          result.className = 'rounded-md border border-red-300 bg-red-50 p-3 text-sm text-red-700';
          result.textContent = `That didn't send. Please email me directly at mahavir.vataliya110@gmail.com.`;
          status.textContent = '';
        } finally {
          submitBtn.disabled = false;
          label.classList.remove('hidden');
          spinner.classList.add('hidden');
        }
      });
    }
  </script>
</BaseLayout>
