---
import { waysOfWorking } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section class="container-x py-20 sm:py-28">
  <SectionHeading
    eyebrow="How I work"
    title="Operating principles."
    description="Six-plus years of remote, customer-facing product work distilled into the practices I actually run on."
    id="how-i-work"
  />

  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      waysOfWorking.map((w) => (
        <div class="card card-hover p-6" data-reveal>
          <span class="grid h-10 w-10 place-items-center rounded-lg bg-brand-500/15 text-brand-300">
            <Icon name={w.icon} class="h-5 w-5" />
          </span>
          <h3 class="mt-4 font-semibold text-white">{w.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{w.detail}</p>
        </div>
      ))
    }
  </div>
</section>
