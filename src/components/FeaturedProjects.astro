---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="container-x py-20 sm:py-28">
  <div class="flex items-end justify-between gap-4">
    <SectionHeading
      eyebrow="Featured work"
      title="Projects I've owned end-to-end."
      description="From enterprise agentic RAG to platforms serving 1M+ users — a selection of recent, high-impact work."
    />
    <a
      href="/projects"
      class="hidden shrink-0 items-center gap-1.5 text-sm font-semibold text-accent-400 hover:text-accent-500 sm:inline-flex"
    >
      All projects
      <Icon name="arrowRight" class="h-4 w-4" />
    </a>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>

  <div class="mt-8 sm:hidden">
    <a href="/projects" class="btn-ghost w-full">
      View all projects
      <Icon name="arrowRight" class="h-4 w-4" />
    </a>
  </div>
</section>
