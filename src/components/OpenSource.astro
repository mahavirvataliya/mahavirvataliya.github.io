---
import { openSource, achievements } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section class="container-x py-20 sm:py-28">
  <SectionHeading
    eyebrow="Open source & community"
    title="Building in public."
    description="Open-source contributions, community presence, and the occasional hackathon win."
  />

  <div class="mt-12 grid gap-5 sm:grid-cols-2">
    {
      openSource.map((item) => (
        <div class="card card-hover flex items-start gap-4 p-6" data-reveal>
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-gradient-brand text-white shadow-lg shadow-brand-900/40">
            <Icon name={item.icon} class="h-6 w-6" />
          </span>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-semibold text-white">{item.title}</h3>
              {item.badge && (
                <span class="rounded-full border border-brand-400/30 bg-brand-500/15 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-brand-300">
                  {item.badge}
                </span>
              )}
            </div>
            <p class="mt-1 text-sm leading-relaxed text-slate-400">{item.detail}</p>
            {item.url && (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-accent-400 hover:text-accent-500"
              >
                {item.urlLabel ?? 'Link'}
                <Icon name="arrowUpRight" class="h-3.5 w-3.5" />
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>

  <!-- Awards strip -->
  {
    achievements.length > 0 && (
      <div class="mt-8 flex flex-wrap items-center gap-4">
        {achievements.map((a) => (
          <div class="card flex items-center gap-3 p-4" data-reveal>
            <Icon name={a.icon} class="h-5 w-5 text-amber-300" />
            <div>
              <p class="text-sm font-semibold text-white">{a.title}</p>
              <p class="text-xs text-slate-400">{a.detail}</p>
            </div>
          </div>
        ))}
      </div>
    )
  }
</section>
