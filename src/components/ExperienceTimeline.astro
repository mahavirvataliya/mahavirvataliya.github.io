---
import { experiences } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section class="container-x py-20 sm:py-28">
  <SectionHeading
    eyebrow="Experience"
    title="8+ years building production software."
    description="From software engineer to chief architect — owning products from first customer conversation to production traces."
    id="experience"
  />

  <div class="mt-12 space-y-8">
    {
      experiences.map((exp) => (
        <div class="card relative p-6 sm:p-8" data-reveal>
          {exp.current && (
            <span class="absolute right-6 top-6 inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs text-emerald-300">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" />
              Current
            </span>
          )}

          <div class="flex flex-wrap items-baseline gap-x-3">
            <h3 class="text-xl font-bold text-white">{exp.role}</h3>
            <span class="text-accent-400">·</span>
            <span class="font-semibold text-slate-200">{exp.company}</span>
          </div>
          <p class="mt-1 font-mono text-xs uppercase tracking-wider text-slate-500">
            {exp.period} · {exp.location}
          </p>

          <ul class="mt-5 space-y-2.5">
            {exp.highlights.map((h) => (
              <li class="flex gap-3 text-sm leading-relaxed text-slate-300">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gradient-brand" />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
