---
import { site, socials, stats } from '../data/site';
import Icon from './Icon.astro';
---

<section class="relative overflow-hidden">
  <!-- Background grid + glow -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-grid-subtle bg-grid [mask-image:radial-gradient(70%_50%_at_50%_0%,#000_0%,transparent_75%)]"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 -top-40 -z-10 h-[500px] bg-radial-glow"
  >
  </div>

  <div class="container-x pb-20 pt-20 sm:pt-28 lg:pt-32">
    <div class="mx-auto max-w-3xl text-center">
      <!-- Availability pill -->
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs text-slate-300"
        data-reveal
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
        </span>
        {site.availability}
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl" data-reveal>
        Hi, I'm <span class="text-gradient">Mahavir Vataliya</span>.
        <br />
        I build & scale
        <span class="text-gradient">software & AI products</span>.
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-400" data-reveal>
        {site.tagline}
      </p>

      <!-- CTAs -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3" data-reveal>
        <a href="/projects" class="btn-primary">
          View my work
          <Icon name="arrowRight" class="h-4 w-4" />
        </a>
        <a href="/resume" class="btn-ghost">
          <Icon name="download" class="h-4 w-4" />
          Download CV
        </a>
        <a href="/contact" class="btn-ghost">Get in touch</a>
      </div>

      <!-- Socials -->
      <div class="mt-8 flex items-center justify-center gap-2" data-reveal>
        {
          socials.map((s) => (
            <a
              href={s.href}
              aria-label={s.label}
              class="grid h-10 w-10 place-items-center rounded-lg border border-white/10 bg-white/5 text-slate-300 transition hover:border-brand-400/50 hover:bg-white/10 hover:text-white"
              {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <Icon name={s.icon} class="h-5 w-5" />
            </a>
          ))
        }
      </div>
    </div>

    <!-- Stats strip -->
    <div class="mx-auto mt-16 grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-4" data-reveal>
      {
        stats.map((stat) => (
          <div class="card p-5 text-center">
            <div class="text-3xl font-bold text-gradient">{stat.value}</div>
            <div class="mt-1 font-mono text-xs uppercase tracking-wider text-slate-500">
              {stat.label}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
