---
import { site, socials } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-white/5 bg-ink-950">
  <div class="container-x py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <!-- Brand -->
      <div class="max-w-sm">
        <div class="flex items-center gap-2 font-semibold text-white">
          <span
            class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-brand text-sm font-bold text-white"
          >
            MV
          </span>
          {site.name}
        </div>
        <p class="mt-4 text-sm leading-relaxed text-slate-400">
          {site.role} building and scaling products end-to-end. Available for remote work.
        </p>
      </div>

      <!-- Links -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        <div>
          <h3 class="font-mono text-xs uppercase tracking-widest text-slate-500">Site</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/" class="text-slate-300 hover:text-white">Home</a></li>
            <li><a href="/projects" class="text-slate-300 hover:text-white">Projects</a></li>
            <li><a href="/resume" class="text-slate-300 hover:text-white">Resume</a></li>
            <li><a href="/contact" class="text-slate-300 hover:text-white">Contact</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-mono text-xs uppercase tracking-widest text-slate-500">Connect</h3>
          <ul class="mt-3 space-y-2 text-sm">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    class="inline-flex items-center gap-2 text-slate-300 hover:text-white"
                    {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    <Icon name={s.icon} class="h-4 w-4" />
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="hr-soft my-8"></div>

    <div class="flex flex-col items-center justify-between gap-3 text-xs text-slate-500 sm:flex-row">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="font-mono">
        Built with <a href="https://astro.build" class="text-accent-400 hover:underline" target="_blank" rel="noopener noreferrer">Astro</a>
        · Hosted on <a href="https://pages.cloudflare.com" class="text-accent-400 hover:underline" target="_blank" rel="noopener noreferrer">Cloudflare Pages</a>
      </p>
    </div>
  </div>
</footer>
