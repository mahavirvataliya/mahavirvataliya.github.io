---
import { site, socials } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-neutral-200">
  <div class="wrap flex flex-col gap-2 py-8 text-sm text-neutral-500 sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {site.name}</p>
    <nav class="flex gap-4" aria-label="Footer">
      {
        socials.map((s) => (
          <a
            href={s.href}
            class="text-neutral-500 no-underline hover:text-neutral-900 hover:underline hover:underline-offset-2"
            {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
