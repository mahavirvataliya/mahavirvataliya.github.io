---
import { getCollection } from 'astro:content';
import BlogCard from './BlogCard.astro';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section class="container-x py-20 sm:py-28">
  <div class="flex items-end justify-between gap-4">
    <SectionHeading
      eyebrow="Writing"
      title="Notes from real systems."
      description="Production AI, performance work, infrastructure decisions, and remote-first collaboration — written from shipped work, not tutorials."
    />
    <a
      href="/blog"
      class="hidden shrink-0 items-center gap-1.5 text-sm font-semibold text-accent-400 hover:text-accent-500 sm:inline-flex"
    >
      All posts
      <Icon name="arrowRight" class="h-4 w-4" />
    </a>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <BlogCard post={post} />)}
  </div>

  <div class="mt-8 sm:hidden">
    <a href="/blog" class="btn-ghost w-full">
      View all posts
      <Icon name="arrowRight" class="h-4 w-4" />
    </a>
  </div>
</section>
