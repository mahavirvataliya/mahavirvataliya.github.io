---
import { skillGroups } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section class="container-x py-20 sm:py-28">
  <SectionHeading
    eyebrow="Skills"
    title="The full stack — frontend to infra to agentic AI."
    description="Hands-on across every layer of modern product engineering, with a bias for production-grade reliability."
    id="skills"
  />

  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      skillGroups.map((group) => (
        <div class="card card-hover p-6" data-reveal>
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-lg bg-brand-500/15 text-brand-300">
              <Icon name={group.icon} class="h-5 w-5" />
            </span>
            <h3 class="font-semibold text-white">{group.title}</h3>
          </div>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <li class="pill">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
