---
export interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  id?: string;
}
const { eyebrow, title, description, align = 'left', id } = Astro.props;
---

<div
  id={id}
  class={align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'}
  data-reveal
>
  <span class="eyebrow">{eyebrow}</span>
  <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-relaxed text-slate-400">{description}</p>}
</div>
