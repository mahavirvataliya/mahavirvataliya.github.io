---
import { site } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const bullets = [
  {
    icon: 'rocket',
    title: 'Owns the full loop',
    detail:
      'Customer conversation → product decision → build → deploy → production traces → iterate. I sit in discovery calls and ship to production.',
  },
  {
    icon: 'ai',
    title: 'Shipped agentic AI products',
    detail:
      'Production enterprise RAG (Knogen.ai), multi-agent orchestration with governance, and structured-output automation — with evaluation before anything hits prod.',
  },
  {
    icon: 'observability',
    title: 'Scaled to 1M+ users',
    detail:
      '99%+ uptime on a B2B/B2C platform via Redis caching, DB indexing, Multi-AZ RDS, CloudFront, and production tracing (New Relic, CloudWatch).',
  },
  {
    icon: 'cloud',
    title: 'Remote-first, 6+ years',
    detail:
      'Direct B2B work with US and EU clients. Strong async communication, high ownership, build-vs-buy discipline.',
  },
];
---

<section class="container-x py-20 sm:py-28">
  <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-start">
    <SectionHeading
      eyebrow="About"
      title="Product-minded full-stack engineer who ships to production."
      id="about"
    />

    <div data-reveal>
      <p class="text-lg leading-relaxed text-slate-300">{site.summary}</p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          bullets.map((b) => (
            <div class="card card-hover p-5">
              <div class="flex items-center gap-3">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-brand-500/15 text-brand-300">
                  <Icon name={b.icon} class="h-5 w-5" />
                </span>
                <h3 class="font-semibold text-white">{b.title}</h3>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-slate-400">{b.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
