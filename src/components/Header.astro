---
import { navItems, site } from '../data/site';
---

<header class="border-b border-neutral-200">
  <div class="wrap flex h-14 items-center justify-between">
    <a href="/" class="font-semibold text-neutral-900 no-underline">
      <span class="hidden sm:inline">{site.name}</span>
      <span class="sm:hidden">Mahavir</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-5 text-sm sm:flex" aria-label="Primary">
      {
        navItems.map((item) => (
          <a href={item.href} class="text-neutral-600 no-underline hover:text-neutral-900 hover:underline hover:underline-offset-2">
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Mobile: same links, tighter -->
    <nav class="flex items-center gap-3 text-xs sm:hidden" aria-label="Primary">
      {
        navItems.map((item) => (
          <a href={item.href} class="text-neutral-600 no-underline">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
