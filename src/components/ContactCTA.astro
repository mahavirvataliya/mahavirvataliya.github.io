---
import { site, socials } from '../data/site';
import Icon from './Icon.astro';
---

<section class="container-x py-20 sm:py-28">
  <div
    class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-brand-900/40 via-ink-850 to-ink-850 p-8 sm:p-14"
    data-reveal
  >
    <!-- Decorative glow -->
    <div class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-20 -left-20 h-72 w-72 rounded-full bg-accent-500/10 blur-3xl"></div>

    <div class="relative mx-auto max-w-2xl text-center">
      <span class="eyebrow">Let's build something</span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Have a product to ship or scale?
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-300">
        I'm {site.availability.toLowerCase()}. Whether it's a greenfield build, a scaling challenge,
        or an AI automation pipeline — let's talk.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/contact" class="btn-primary">
          Start a conversation
          <Icon name="arrowRight" class="h-4 w-4" />
        </a>
        <a href={`mailto:${site.email}`} class="btn-ghost">
          <Icon name="email" class="h-4 w-4" />
          {site.email}
        </a>
      </div>

      <div class="mt-8 flex items-center justify-center gap-2">
        {
          socials.map((s) => (
            <a
              href={s.href}
              aria-label={s.label}
              class="grid h-10 w-10 place-items-center rounded-lg border border-white/10 bg-white/5 text-slate-300 transition hover:border-brand-400/50 hover:bg-white/10 hover:text-white"
              {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <Icon name={s.icon} class="h-5 w-5" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
