const isDecorative = !label;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  role={label ? 'img' : 'presentation'}
  aria-hidden={isDecorative ? 'true' : undefined}
  aria-label={label}
  set:html={paths[name] ?? ''}
/>
