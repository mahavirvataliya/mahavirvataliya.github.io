---
import { achievements } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section class="container-x py-20 sm:py-28">
  <SectionHeading
    eyebrow="Beyond the day job"
    title="Open source & achievements."
  />

  <div class="mt-12 grid gap-5 sm:grid-cols-2">
    {
      achievements.map((a) => (
        <div class="card card-hover flex items-start gap-4 p-6" data-reveal>
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-gradient-brand text-white shadow-lg shadow-brand-900/40">
            <Icon name={a.icon} class="h-6 w-6" />
          </span>
          <div>
            <h3 class="font-semibold text-white">{a.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-slate-400">{a.detail}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
