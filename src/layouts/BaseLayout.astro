---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, image, path, noindex } = Astro.props;
const origin = Astro.site?.origin ?? 'https://mahavirvataliya.github.io';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Writing" href="/rss.xml" />
    <SEO title={title} description={description} image={image} path={path} noindex={noindex} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Mahavir Vataliya',
        jobTitle: 'Full-Stack Engineer',
        email: 'mailto:mahavir.vataliya110@gmail.com',
        address: { '@type': 'PostalAddress', addressLocality: 'Vadodara', addressCountry: 'IN' },
        url: origin,
        sameAs: [
          'https://github.com/mahavirvataliya',
          'https://linkedin.com/in/mahavirvataliya',
        ],
        knowsAbout: [
          'React', 'NextJS', 'TypeScript', 'Supabase', 'PostgreSQL', 'Python', 'FastAPI',
          'LangChain', 'Retrieval-Augmented Generation', 'Node.js', 'Laravel', 'AWS',
          'Cloudflare', 'Terraform', 'Docker', 'CI/CD', 'Redis', 'Production Observability',
        ],
      })}
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:text-neutral-900 focus:shadow"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
